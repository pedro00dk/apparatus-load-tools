{
    "name": "@_apparatus_/load-tools",
    "description": "Easily create loading skeletons and overlays that adapt to content at runtime.",
    "version": "4.0.3",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pedro00dk/apparatus-load-tools"
    },
    "author": {
        "name": "Pedro Henrique",
        "email": "pedro00dk@gmail.com"
    },
    "keywords": [
        "loading",
        "overlay",
        "skeleton",
        "skeletons",
        "solid-js",
        "util"
    ],
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./solid": {
            "import": "./dist/solid.js",
            "types": "./dist/solid.d.ts"
        }
    },
    "devDependencies": {
        "@solidjs/web": "^2.0.0-rc.9",
        "@types/bun": "1.4.2",
        "typescript": "7.0.2",
        "solid-js": "^2.0.0-rc.9"
    },
    "peerDependencies": {
        "@solidjs/web": "^2.0.0-rc.9",
        "solid-js": "^2.0.0-rc.9"
    },
    "peerDependenciesMeta": {
        "@solidjs/web": {
            "optional": true
        },
        "solid-js": {
            "optional": true
        }
    },
    "scripts": {
        "build": "tsc && bun build --splitting --external solid-js --outdir ./dist/ ./src/index.ts ./src/solid.ts",
        "test": "bun test --pass-with-no-tests"
    }
}
